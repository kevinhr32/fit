# Copia este archivo como .env y completa los valores.
# .env NO se commitea (esta en .gitignore).

# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-aqui

# True para desarrollo, False para produccion
DEBUG=True

# Hosts permitidos (separados por comas). En produccion: midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Solo en produccion: URL de conexion a Postgres (Railway la genera sola
# al agregar el plugin de base de datos, no hay que armarla a mano).
# Formato: postgres://usuario:password@host:puerto/nombre_bd
# Si no se define, el proyecto usa SQLite local (comportamiento por defecto).
# DATABASE_URL=postgres://...

# Solo en produccion: dominio del frontend desplegado (separados por comas)
# para que el navegador pueda llamar a esta API.
# CORS_ALLOWED_ORIGINS=https://tu-frontend.up.railway.app
