# Copia este archivo como .env y completa los valores.
# .env NO se commitea (esta en .gitignore).

# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-aqui

# True para desarrollo, False para produccion
DEBUG=True

# Hosts permitidos (separados por comas). En produccion: midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1
